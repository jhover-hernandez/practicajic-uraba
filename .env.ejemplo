# Variables del despliegue piloto (docker-compose.piloto.yml).
# Copia este archivo como .env y cambia TODOS los valores de ejemplo. El archivo .env no se sube a Git.

# Base de datos
DB_CONTRASENA=cambia-esta-clave-de-base-de-datos

# Clave para firmar los tokens: Base64 de al menos 256 bits. Genérala con:  openssl rand -base64 48
APP_JWT_SECRETO=pega-aqui-la-clave-generada

# Primer administrador (solo se crea si no existe ninguno)
APP_ADMIN_CORREO=admin@elpoli.edu.co
APP_ADMIN_CONTRASENA=CambiaEstaClave2026

# Dirección pública de la plataforma (se usa en los enlaces de los correos)
APP_FRONTEND_URL=http://practicajic.elpoli.edu.co
PUERTO_WEB=80

# true cuando la plataforma se sirve por HTTPS (recomendado). Con HTTP simple debe ser false
# o la sesión no se conserva al recargar la página.
APP_COOKIE_SEGURA=false

# RN-02: puntaje mínimo de la matriz de 100 puntos para aprobar una oferta
APP_PUNTAJE_MINIMO=70

# Correo saliente (recuperación de contraseña y avisos). Con false los mensajes se escriben en el log del backend.
APP_CORREO_HABILITADO=false
APP_CORREO_REMITENTE=practicas.uraba@elpoli.edu.co
MAIL_HOST=smtp.office365.com
MAIL_PORT=587
MAIL_USUARIO=
MAIL_CONTRASENA=
